{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "allowJs": false,
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ESNext",
    "incremental": false,
    "declaration": false,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "noErrorTruncation": true,
    "resolveJsonModule": true,
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  }
}
